{
  "name": "@loomwright/cli",
  "version": "0.12.0",
  "description": "Loomwright: repo-local AI software factory — OpenSpec + Graphify + opencode v2",
  "license": "MIT",
  "author": "Lars Roth",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supporterino/Loomwright.git"
  },
  "homepage": "https://github.com/Supporterino/Loomwright#readme",
  "bugs": {
    "url": "https://github.com/Supporterino/Loomwright/issues"
  },
  "packageManager": "bun@1.4.4",
  "bin": {
    "loomwright": "./dist/cli.js",
    "ai-factory": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "templates/addons/ponytail/LICENSE"
  ],
  "engines": {
    "node": ">=20.3",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build-plugin.ts && bun build src/cli/bin.ts --target=node --outfile dist/cli.js && bun scripts/write-dist-package.ts",
    "dev": "bun src/cli/bin.ts",
    "test": "bun test --timeout 60000 --parallel",
    "test:serial": "bun test --timeout 60000",
    "test:fast": "bun test --timeout 60000 --parallel --path-ignore-patterns='**/pipeline.test.ts' --path-ignore-patterns='**/workspace-install.test.ts' --path-ignore-patterns='**/reword.test.ts' --path-ignore-patterns='**/gates-run.test.ts' --path-ignore-patterns='**/review-loop.test.ts' --path-ignore-patterns='**/init.test.ts' --path-ignore-patterns='**/contract-gate.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && tsc --noEmit && bun run test",
    "changeset": "changeset",
    "release:version": "changeset version && bun scripts/sync-version.ts && bun scripts/release-snapshot.ts",
    "build:plugin": "bun scripts/build-plugin.ts",
    "vendor:ponytail": "bun scripts/vendor-ponytail.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@fission-ai/openspec": "1.14.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
